  0.0, 0.0, 0.0, 0.0,      !- Coefficients
  -100, 100, 0, -100, 100; !- Temperature limits

ScheduleTypeLimits,
  Fraction,                !- Name
  0.0,                     !- Lower Limit Value
  1.0,                     !- Upper Limit Value
  Continuous;              !- Numeric Type

Schedule:Constant,
  Always On,               !- Name
  Fraction,                !- Schedule Type Limits Name
  1.0;                     !- Hourly Value

Schedule:Constant,
  Greenhouse Shade Fraction, !- Name
