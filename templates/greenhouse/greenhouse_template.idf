Version,
  23.1;                  !- Version Identifier

Building,
  Greenhouse Template,   !- Name
  0,                      !- North Axis {deg}
  City,                   !- Terrain
  0.04,                   !- Loads Convergence Tolerance Value
  0.4,                    !- Temperature Convergence Tolerance Value {deltaC}
  FullExterior,           !- Solar Distribution
  25;                     !- Maximum Number of Warmup Days

SimulationControl,
  No,                     !- Do Zone Sizing Calculation
  No,                     !- Do System Sizing Calculation
  No,                     !- Do Plant Sizing Calculation
  No,                     !- Run Simulation for Sizing Periods
  Yes;                    !- Run Simulation for Weather File Run Periods

Timestep,
  4;

RunPeriod,
  Annual Run Period,      !- Name
  1,                      !- Begin Month
  1,                      !- Begin Day of Month
  12,                     !- End Month
  31,                     !- End Day of Month
  Tuesday,                !- Day of Week for Start Day
  Yes,                     !- Use Weather File Holidays and Special Days
  Yes,                     !- Use Weather File Daylight Saving Period
  No,                      !- Apply Weekend Holiday Rule
  Yes,                     !- Use Weather File Rain Indicators
  Yes;                     !- Use Weather File Snow Indicators

Site:Location,
  Simplified Greenhouse,  !- Name
  41.39,                  !- Latitude {deg}
  2.17,                   !- Longitude {deg}
  1.0,                    !- Time Zone {hr}
  10.0;                   !- Elevation {m}

GlobalGeometryRules,
  UpperLeftCorner,         !- Starting Vertex Position
  CounterClockWise,        !- Vertex Entry Direction
  World;                   !- Coordinate System

Zone,
  Greenhouse Zone,         !- Name
  0,                       !- Direction of Relative North {deg}
  0, 0, 0,                 !- X,Y,Z Origin {m}
  1,                       !- Type
  1,                       !- Multiplier
  autocalculate,           !- Ceiling Height {m}
  autocalculate;           !- Volume {m3}

Material,
  Greenhouse Floor,        !- Name
  MediumSmooth,            !- Roughness
  0.20,                    !- Thickness {m}
  1.40,                    !- Conductivity {W/m-K}
  1800,                    !- Density {kg/m3}
  800,                     !- Specific Heat {J/kg-K}
  0.90,                    !- Thermal Absorptance
  0.70,                    !- Solar Absorptance
  0.70;                    !- Visible Absorptance

WindowMaterial:SimpleGlazingSystem,
  Greenhouse Glazing,      !- Name
  2.7,                     !- U-Factor {W/m2-K}
  0.70,                    !- Solar Heat Gain Coefficient
  0.78;                    !- Visible Transmittance

Construction,
  Greenhouse Glazing Construction, !- Name
  Greenhouse Glazing;      !- Outside Layer

