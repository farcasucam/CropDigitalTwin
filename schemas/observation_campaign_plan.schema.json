{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crop-digital-twin.local/schemas/observation_campaign_plan.schema.json",
  "title": "Experimental observation campaign plan",
  "type": "object",
  "required": ["campaign_status", "real_data_available", "items"],
  "properties": {
    "campaign_status": {"const": "DESIGNED_NOT_EXECUTED"},
    "real_data_available": {"const": false},
    "coverage": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["observation_id", "parameter_ids", "purpose", "measurement_method", "temporal_resolution", "priority", "status", "source_type", "quality_requirements"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "parameter_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "variable": {"type": ["string", "null"]},
        "purpose": {"type": "string", "minLength": 1},
        "crop": {"type": ["string", "null"], "enum": ["tomato", "lettuce", "pepper", "grape", "peach", "plum", "apple", null]},
        "variety": {"type": ["string", "null"]},
        "plot": {"type": ["string", "null"]},
        "environment": {"type": ["string", "null"]},
        "phenological_stage": {"type": ["string", "null"]},
        "measurement_method": {"type": "string"},
        "unit": {"type": ["string", "null"]},
        "temporal_resolution": {"type": "string"},
        "spatial_scope": {"type": "string"},
        "required_conditions": {"type": "array", "items": {"type": "string"}},
        "uncertainty_target": {"type": "string"},
        "quality_requirements": {"type": "array", "items": {"type": "string"}},
        "source_type": {"enum": ["scientific_requirement", "engineering_recommendation", "project_requirement", "unknown"]},
        "source_reference": {"type": ["string", "null"]},
        "evidence_level": {"type": "string"},
        "confidence": {"type": "string"},
        "priority": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
        "status": {"enum": ["NOT_PLANNED", "PARTIAL", "PLANNED", "UNKNOWN"]},
        "confounders": {"type": "array", "items": {"type": "string"}},
        "identifiability_status": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
