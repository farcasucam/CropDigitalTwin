{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agri-digital-twin.local/schemas/weather-1.0.json",
  "title": "Weather data",
  "type": "object",
  "required": ["temperature_c", "relative_humidity_pct", "solar_radiation_w_m2", "wind_speed_m_s", "wind_direction_deg", "rain_rate_mm_h", "pressure_hpa"],
  "properties": {
    "temperature_c": {"type": "number"},
    "relative_humidity_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "solar_radiation_w_m2": {"type": "number", "minimum": 0},
    "wind_speed_m_s": {"type": "number", "minimum": 0},
    "wind_direction_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
    "rain_rate_mm_h": {"type": "number", "minimum": 0},
    "pressure_hpa": {"type": "number"}
  },
  "additionalProperties": true
}